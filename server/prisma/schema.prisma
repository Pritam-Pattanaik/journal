generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  password  String
  fullName  String?   @map("full_name")
  avatarUrl String?   @map("avatar_url")
  timezone  String?   @default("Asia/Kolkata")
  role      String    @default("USER")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  trades             Trade[]
  strategies         Strategy[]
  journalEntries     JournalEntry[]
  aiInsights         AiInsight[]
  aiConversations    AiConversation[]
  coachMemories      CoachMemory[]
  brokerConnections  BrokerConnection[]
  tradingRules       TradingRule?
  auditLogs          AuditLog[]
  notes              Note[]
  weeklyReviews      WeeklyReview[]
  monthlyReflections MonthlyReflection[]
  goals              Goal[]
  newsBookmarks      NewsBookmark[]
  notifications      Notification[]
  watchlist          UserWatchlist[]


  @@map("users")
}

model BrokerConnection {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  broker       String
  apiKey       String?   @map("api_key")
  apiSecret    String?   @map("api_secret")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  tokenExpiry  DateTime? @map("token_expiry")
  clientId     String?   @map("client_id")
  isActive     Boolean?  @default(false) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")
  metadata     String?
  createdAt    DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("broker_connections")
}

model Strategy {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  description String?
  rules       String?
  market      String[]
  timeframe   String?
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@map("strategies")
}

model Trade {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  broker           String
  brokerTradeId    String?   @map("broker_trade_id")
  date             DateTime
  exitTime         DateTime? @map("exit_time")
  isCarryForward   Boolean   @default(false) @map("is_carry_forward")
  symbol           String
  market           String
  instrumentType   String    @map("instrument_type")
  direction        String?
  entryPrice       Decimal?  @map("entry_price")
  exitPrice        Decimal?  @map("exit_price")
  quantity         Decimal?
  pnl              Decimal?
  charges          Decimal?
  netPnl           Decimal?  @map("net_pnl")
  status           String?
  strategyId       String?   @map("strategy_id") @db.Uuid
  setupDescription String?   @map("setup_description")
  mindset          String?
  decisionNotes    String?   @map("decision_notes")
  learnings        String?
  disciplineScore   Int?      @map("discipline_score")
  disciplineRawScore Float?   @map("discipline_raw_score")
  disciplineReasons Json?     @map("discipline_reasons")
  disciplineSignals Json?     @map("discipline_signals")
  disciplineBreakdown Json?   @map("discipline_breakdown")
  behaviourProfile Json?      @map("behaviour_profile")
  confidence      Float?      @map("confidence")
  tradingStyle    String?     @map("trading_style")
  disciplineVersion Int?      @default(1) @map("discipline_version")
  isManualOverride  Boolean?  @default(false) @map("is_manual_override")
  manualScore       Int?      @map("manual_score")
  computedAt        DateTime? @map("computed_at")
  tags             String[]
  source           String?
  stopLoss         Decimal?  @map("stop_loss")
  mistakes         String[]
  checklist        Json?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @default(now()) @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy    Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  aiInsights  AiInsight[]
  screenshots Screenshot[]
  newsLinks   TradeNewsLink[]

  @@index([userId, date])
  @@index([userId, broker])
  @@index([userId, status])
  @@index([userId, market])
  @@map("trades")
}

model JournalEntry {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  date              DateTime  @db.Date
  marketBias        String?   @map("market_bias")
  keyLevels         String?   @map("key_levels")
  watchlist         String?
  newsNotes         String?   @map("news_notes")
  reflection        String?
  whatWentWell      String?   @map("what_went_well")
  whatToImprove     String?   @map("what_to_improve")
  mood              String?
  overallDiscipline Int?      @map("overall_discipline")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

model AiInsight {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  type                String?
  tradeId             String?   @map("trade_id") @db.Uuid
  content             String
  tradesAnalyzedCount Int?      @map("trades_analyzed_count")
  dateRangeStart      DateTime? @map("date_range_start")
  dateRangeEnd        DateTime? @map("date_range_end")
  createdAt           DateTime? @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

model AiConversation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String
  isPinned   Boolean   @default(false) @map("is_pinned")
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime? @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model CoachMemory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  patternType   String    @map("pattern_type")
  title         String
  description   String
  severity      String    @default("warning")
  count         Int       @default(0)
  previousCount Int       @default(0) @map("previous_count")
  avgPnl        Decimal?  @map("avg_pnl")
  detectedAt    DateTime? @default(now()) @map("detected_at")
  updatedAt     DateTime? @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_memory")
}

model TradingRule {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  windowStart        String?   @map("window_start")
  windowEnd          String?   @map("window_end")
  maxTradesPerDay    Int?      @map("max_trades_per_day")
  maxDailyLoss       Decimal?  @map("max_daily_loss")
  maxLossPerTrade    Decimal?  @map("max_loss_per_trade")
  allowedInstruments String[]  @map("allowed_instruments")
  allowedMarkets     String[]  @map("allowed_markets")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trading_rules")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    String?
  timestamp  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemSetting {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String    @unique
  value     String
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  @@map("system_settings")
}

model WeeklyReview {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weekOf    DateTime @db.Date
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weekly_reviews")
}

model MonthlyReflection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  month     String
  answers   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monthly_reflections")
}

model Goal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  description String
  type        String
  target      Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions GoalCompletion[]

  @@map("goals")
}

model GoalCompletion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  date      DateTime @db.Date
  completed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_completions")
}

model Screenshot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tradeId   String   @map("trade_id") @db.Uuid
  url       String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("screenshots")
}

model Note {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String?
  content     String
  category    String   @default("Personal Notes")
  tags        String[]
  isFavorite  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model EnrichedNews {
  id               String   @id // Using Finnhub ID or hash
  headline         String
  url              String
  publishedAt      Int
  source           String
  image            String?
  originalSummary  String?
  aiSummary        String?
  tldr             String?
  whyItMatters     String?
  categories       String[] 
  sectors          String[] 
  companies        String[] 
  financialTerms   Json?    
  historicalContext String?
  shortTermImpact  String?
  longTermImpact   String?
  whatToWatchNext  String?
  riskFactors      String?
  probability      Int?
  confidence       Int?
  marketImpact     Json?
  relatedArticles  Json?    
  
  bookmarks        NewsBookmark[]
  tradeLinks       TradeNewsLink[]

  createdAt        DateTime @default(now()) @map("created_at")

  @@map("enriched_news")
}

model NewsBookmark {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  newsId     String @map("news_id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  news       EnrichedNews @relation(fields: [newsId], references: [id], onDelete: Cascade)
  
  @@unique([userId, newsId])
  @@map("news_bookmarks")
}

model TradeNewsLink {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tradeId    String @map("trade_id") @db.Uuid
  newsId     String @map("news_id")
  reason     String?
  
  trade      Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  news       EnrichedNews @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([tradeId, newsId])
  @@map("trade_news_links")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  description String
  category    String   // 'Trading' | 'Risk' | 'Market' | 'AI' | 'Reports'
  priority    String   // 'Critical' | 'Warning' | 'Success' | 'Information'
  isRead      Boolean  @default(false) @map("is_read")
  actionLabel String?  @map("action_label")
  actionUrl   String?  @map("action_url")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, category])
  @@map("notifications")
}

// ─── AI News Engine Models ────────────────────────────────────────────────────

model NewsRawItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source       String   // "NSE" | "BSE" | "RBI" | "PIB" | "NEWSDATA" | "MACRO"
  externalId   String?  @map("external_id")
  dedupeHash   String   @unique @map("dedupe_hash") // SHA-256 of normalised headline+source+date
  headline     String
  body         String?
  url          String?
  publishedAt  DateTime @map("published_at")
  rawPayload   Json     @map("raw_payload")
  status       String   @default("PENDING") // PENDING | TRIAGED | SCORED | DELIVERED | FAILED
  failureReason String? @map("failure_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  triage       NewsTriage?
  impact       NewsImpact?

  @@index([source, status])
  @@index([publishedAt])
  @@index([status, createdAt])
  @@map("news_raw_items")
}

model NewsTriage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawItemId    String   @unique @map("raw_item_id") @db.Uuid
  relevant     Boolean
  category     String   // earnings | regulatory | macro | global | other
  urgency      String   // breaking | routine
  modelVersion String   @map("model_version")
  latencyMs    Int      @map("latency_ms")
  tokensIn     Int?     @map("tokens_in")
  tokensOut    Int?     @map("tokens_out")
  createdAt    DateTime @default(now()) @map("created_at")

  rawItem      NewsRawItem @relation(fields: [rawItemId], references: [id], onDelete: Cascade)

  @@index([relevant, urgency])
  @@map("news_triage")
}

model NewsImpact {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawItemId           String   @unique @map("raw_item_id") @db.Uuid
  sectorImpact        String[] @map("sector_impact")
  direction           String   // positive | negative | neutral | mixed
  confidence          String   // high | medium | low
  rationale           String   // ≤200 words, sector-level only (EDUCATIONAL_MODE)
  historicalAnalogues Json     @map("historical_analogues")
  mode                String   @default("EDUCATIONAL_MODE")
  disclaimer          String   // Mandatory SEBI disclaimer attached at generation time
  modelVersion        String   @map("model_version")
  latencyMs           Int      @map("latency_ms")
  tokensIn            Int?     @map("tokens_in")
  tokensOut           Int?     @map("tokens_out")
  humanReviewRequired Boolean  @default(true) @map("human_review_required")
  humanApproved       Boolean? @map("human_approved")
  humanNotes          String?  @map("human_notes")
  complianceAuditId   String   @unique @map("compliance_audit_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  rawItem      NewsRawItem  @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  auditLog     NewsAuditLog @relation(fields: [complianceAuditId], references: [id])
  backtests    NewsBacktest[]

  @@index([direction, confidence])
  @@index([createdAt])
  @@map("news_impact")
}

model NewsAuditLog {
  // Immutable compliance record — no UPDATE or DELETE in application code.
  // Required under SEBI regulations as evidence that AI outputs were reviewed.
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawItemId        String   @map("raw_item_id") @db.Uuid
  inputSnapshot    Json     @map("input_snapshot")   // Full prompt sent to model
  outputSnapshot   Json     @map("output_snapshot")  // Full raw model response
  modelId          String   @map("model_id")         // e.g. "claude-haiku-4-5"
  promptVersion    String   @map("prompt_version")   // e.g. "scoring-v1.0"
  mode             String   @default("EDUCATIONAL_MODE")
  compliancePassed Boolean  @map("compliance_passed")
  complianceNotes  String?  @map("compliance_notes") // Why filter triggered (if any)
  disclaimer       String
  timestamp        DateTime @default(now())

  impact           NewsImpact?

  @@index([rawItemId])
  @@index([timestamp])
  @@map("news_audit_logs")
}

model NewsBacktest {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  impactId         String   @map("impact_id") @db.Uuid
  sector           String
  taggedDirection  String   @map("tagged_direction") // positive | negative | neutral | mixed
  session1Return   Float?   @map("session1_return")  // actual index return after 1 session
  session3Return   Float?   @map("session3_return")
  session5Return   Float?   @map("session5_return")
  directionMatch1  Boolean? @map("direction_match_1")
  directionMatch3  Boolean? @map("direction_match_3")
  directionMatch5  Boolean? @map("direction_match_5")
  measuredAt       DateTime? @map("measured_at")
  createdAt        DateTime @default(now()) @map("created_at")

  impact           NewsImpact @relation(fields: [impactId], references: [id], onDelete: Cascade)

  @@index([sector, taggedDirection])
  @@map("news_backtests")
}

model UserWatchlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   // "sector" | "ticker"
  value     String   // e.g. "Nifty Bank" | "RELIANCE"
  createdAt DateTime @default(now()) @map("created_at")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, value])
  @@index([userId])
  @@map("user_watchlist")
}

model NewsDigest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String   // "PRE_MARKET" | "EOD"
  date      DateTime @db.Date
  content   Json     // structured digest payload
  itemCount Int      @default(0) @map("item_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([type, date])
  @@index([date])
  @@map("news_digests")
}

model PipelineMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricName  String   @map("metric_name") // e.g. "items_ingested", "triage_pass_rate"
  value       Float
  source      String?  // optional source tag (NSE, BSE, etc.)
  tags        Json?
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([metricName, recordedAt])
  @@map("pipeline_metrics")
}
